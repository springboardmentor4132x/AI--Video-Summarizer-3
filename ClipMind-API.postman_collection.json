    {
      "name": "Video Management",
      "item": [
        {
          "name": "Upload Video & Extract Audio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "JWT token from login endpoint"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "disabled": false
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/video/process",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "video",
                "process"
              ]
            },
            "description": "Upload an MP4 video file. Extracts audio to WAV format and saves video record to database.\n\nRequirements:\n- File must be MP4 format\n- File size must not exceed 100MB\n- Authentication required (Bearer token)"
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n  \"status\": \"processed\",\n  \"video_id\": 1,\n  \"filename\": \"sample.mp4\",\n  \"file_path\": \"uploads/sample.mp4\",\n  \"audio_path\": \"uploads/sample.wav\",\n  \"db_status\": \"uploaded\",\n  \"uploaded_at\": \"2024-01-15T10:30:45.123456\"\n}"
            }
          ]
        },
        {
          "name": "Get User's Upload History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "JWT token from login endpoint"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/videos/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "videos",
                "me"
              ]
            },
            "description": "Retrieve all videos uploaded by the current user. Returns list ordered by most recent first."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [],
              "body": "{\n  \"user_id\": 1,\n  \"videos\": [\n    {\n      \"id\": 1,\n      \"filename\": \"presentation.mp4\",\n      \"file_path\": \"uploads/presentation.mp4\",\n      \"status\": \"uploaded\",\n      \"uploaded_at\": \"2024-01-15T10:30:45.123456\"\n    },\n    {\n      \"id\": 2,\n      \"filename\": \"lecture.mp4\",\n      \"file_path\": \"uploads/lecture.mp4\",\n      \"status\": \"uploaded\",\n      \"uploaded_at\": \"2024-01-14T14:22:10.987654\"\n    }\n  ]\n}"
            }
          ]
        }
      ]
